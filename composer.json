{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "determined-development/dd-laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "archtechx/enums": "^1.1",
        "aws/aws-sdk-php": "^3.380",
        "blade-ui-kit/blade-heroicons": "^2.4",
        "blade-ui-kit/blade-icons": "^1.6",
        "laravel/framework": "^13.8",
        "laravel/prompts": "^0.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^4.1",
        "spatie/laravel-data": "^4.22"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.1",
        "determined-development/dd-boost": "^1.1",
        "determined-development/laradev": "^1.1",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "*",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1",
        "spatie/laravel-ray": "^1.38",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.sail', '.env');\"",
            "sail build",
            "sail artisan key:generate"
        ],
        "lint:pint": "pint --test --parallel",
        "lint:phpcs": "phpcs ./",
        "lint:assets": [
            "npx biome check",
            "npx oxlint",
            "npx eslint"
        ],
        "lint": [
            "@lint:pint",
            "@lint:phpcs",
            "@lint:assets"
        ],
        "pint:fix": "pint --parallel",
        "phpcs:fix": "phpcbf ./",
        "biome:fix": "npx biome check --fix",
        "lint:fix": [
            "@pint:fix",
            "@phpcs:fix",
            "@biome:fix"
        ],
        "test": "@php artisan test --parallel",
        "test:types": "phpstan analyse",
        "test:arch": "pest --testsuite Architecture --parallel",
        "test:feat": "pest --testsuite Feature --parallel",
        "test:unit": "pest --testsuite Unit --parallel",
        "test:all": [
            "@lint",
            "@test:types",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.sail', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "sail build"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
