{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "env": {
        "browser": true
    },
    "plugins": ["unicorn", "oxc"],
    "globals": {},
    "settings": {},
    "rules": {
        "eqeqeq": "warn",
        "import/no-cycle": "error",
        "no-alert": "error",
        "no-console": "warn",
        "no-empty": "warn",
        "no-empty-function": "warn",
        "no-eval ": "warn",
        "no-implied-eval": "warn"
    }
}